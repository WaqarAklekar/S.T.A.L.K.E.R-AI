PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated frontend origins. For local dev:
FRONTEND_ORIGIN=http://localhost:5173

# IMPORTANT:
# The backend developer's current production app already uses Neo4j + Postgres.
# This reference server intentionally keeps the data adapter simple so you can
# run a demo without exposing database secrets. If your teammate already has
# the live backend, DO NOT replace it with this file; use their Render API.
